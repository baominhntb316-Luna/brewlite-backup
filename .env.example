# Local-only placeholders. Never put actual secret values here.
NODE_ENV=development

# API
API_PORT=3001
JWT_SECRET=replace-with-local-dev-secret-at-least-32-chars
JWT_EXPIRES_IN=1h
PAYMENT_MOCK_MODE=success

# PostgreSQL (inside Docker Compose network)
POSTGRES_DB=brewlite
POSTGRES_USER=brewlite
POSTGRES_PASSWORD=replace-local-password
DATABASE_URL=postgresql://brewlite:replace-local-password@db:5432/brewlite?schema=public

# Web: value is public to browser, so it must not contain secrets
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
