@startuml deployment
title Sơ đồ Triển khai Production (Deployment Diagram - VPS, Docker & Caddy TLS)

node "Thiết bị Người dùng (Client Device)" {
  artifact "Trình duyệt Web / PWA" as ClientBrowser
}

cloud "Mạng Internet Công cộng" as Internet

node "Hệ thống CI/CD (GitHub Actions)" as CICD {
  component "Runner Ubuntu" {
    [Quality Gate: Lint + Test + Build] as QG
    [Docker Build & Tag SHA] as DockerBuild
  }
}

cloud "GitHub Container Registry (GHCR)" as GHCR {
  artifact "web:commit-sha" as ImgWeb
  artifact "api:commit-sha" as ImgApi
}

node "Máy chủ Sản xuất (Production Linux VPS)" as VPS {
  component "Caddy Reverse Proxy" as Proxy {
    portin "443: HTTPS" as P443
    portin "80: HTTP (Redirect)" as P80
  }

  folder "Docker Compose Private Network" as DockerNet {
    node "Container Web (Next.js)" as CWeb {
      portin "3000: Internal" as PWeb
      component "Next.js Node Server"
    }

    node "Container API (NestJS)" as CApi {
      portin "3001: Internal" as PApi
      component "NestJS Application"
    }

    node "Container Database (PostgreSQL 16)" as CDB {
      portin "5432: Internal Only\n(CẤM public ra Internet)" as PDB
      component "PostgreSQL Engine"
    }
  }

  storage "Docker Persistent Volume" as Vol {
    folder "/var/lib/postgresql/data" as DataDir
  }

  file "/etc/brewlite/.env (Chmod 600)" as HostSecrets
}

ClientBrowser --> Internet : HTTPS (:443)
Internet --> P443

P443 --> PWeb : Reverse proxy (Web routes)
P443 --> PApi : Reverse proxy (/api, /health)

PWeb ..> PApi : Internal REST calls (:3001)
PApi --> PDB : SQL TCP (:5432 nội bộ)
CDB --> DataDir : Persistent storage

DockerBuild --> GHCR : Push immutable image (tag SHA)
CICD --> VPS : Deploy via SSH (Pull SHA & Rolling restart)
HostSecrets ..> CApi : Nạp biến môi trường an toàn
HostSecrets ..> CDB : Nạp mật khẩu CSDL an toàn
@enduml
