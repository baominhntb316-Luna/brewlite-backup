@startuml class-domain
title Sơ đồ Lớp Miền Nghiệp vụ BrewLite (Domain Model Class Diagram)

skinparam classAttributeIconSize 0

enum OrderStatus {
  PENDING
  PAID
  PREPARING
  READY
  COMPLETED
  PAYMENT_FAILED
  CANCELLED
}

enum PaymentStatus {
  PROCESSING
  SUCCEEDED
  FAILED
  UNKNOWN
}

enum PaymentMethod {
  WALLET
  CARD
}

enum UserRole {
  CUSTOMER
  STAFF
  ADMIN
}

enum Size {
  S
  M
  L
}

enum DiscountKind {
  PERCENT
  FIXED
}

class User {
  +id: UUID
  +email: string
  +passwordHash: string
  +loyaltyPoints: int
  +role: UserRole
  +createdAt: DateTime
}

class Product {
  +id: UUID
  +name: string
  +basePrice: Decimal
  +imageUrl: string
  +stock: int
  +stockVersion: int
  +isActive: boolean
  +createdAt: DateTime
}

class ProductVariant {
  +id: UUID
  +productId: UUID
  +size: Size
  +priceDelta: Decimal
}

class Topping {
  +id: UUID
  +name: string
  +extraPrice: Decimal
  +active: boolean
}

class Order {
  +id: UUID
  +userId: UUID
  +status: OrderStatus
  +subtotal: Decimal
  +discount: Decimal
  +total: Decimal
  +createdAt: DateTime
}

class OrderItem {
  +id: UUID
  +orderId: UUID
  +productId: UUID
  +size: Size
  +qty: int
  +unitPrice: Decimal
  +lineTotal: Decimal
}

class OrderItemTopping {
  +orderItemId: UUID
  +toppingId: UUID
  +priceAtPurchase: Decimal
}

class Payment {
  +id: UUID
  +orderId: UUID
  +idempotencyKey: string
  +payloadHash: string
  +amount: Decimal
  +method: PaymentMethod
  +status: PaymentStatus
  +createdAt: DateTime
}

class Promotion {
  +id: UUID
  +code: string
  +kind: DiscountKind
  +value: Decimal
  +startsAt: DateTime
  +endsAt: DateTime
  +usageLimit: int
  +usageCount: int
  +active: boolean
}

class LoyaltyTransaction {
  +id: UUID
  +userId: UUID
  +orderId: UUID
  +points: int
  +createdAt: DateTime
}

User "1" -- "0..*" Order : places >
User "1" -- "0..*" LoyaltyTransaction : earns >
Order "1" -- "1..*" OrderItem : contains >
Product "1" -- "0..*" OrderItem : referenced in >
Product "1" -- "1..*" ProductVariant : has variants >
OrderItem "1" -- "0..*" OrderItemTopping : includes >
Topping "1" -- "0..*" OrderItemTopping : referenced in >
Order "1" -- "0..*" Payment : settled by >
Promotion "0..1" -- "0..*" Order : applied to >
Order "1" -- "0..1" LoyaltyTransaction : rewards >

note right of Payment
  <b>Ràng buộc tính toàn vẹn:</b>
  - idempotencyKey là duy nhất (UNIQUE)
  - payloadHash ngăn đổi payload cùng key
  - Mỗi lần retry tạo một bản ghi attempt mới
end note

note right of LoyaltyTransaction
  <b>Ràng buộc duy nhất:</b>
  - (userId, orderId) là duy nhất (UNIQUE)
  - Ngăn chặn cộng điểm thưởng nhiều lần
end note
@enduml
