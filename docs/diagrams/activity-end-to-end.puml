@startuml activity-end-to-end
title Sơ đồ Hoạt động End-to-End BrewLite (Activity Diagram with Swimlanes)

skinparam conditionStyle insidediamond
skinparam BoxPadding 10
skinparam ParticipantPadding 10

|#E8F4F8|Khách hàng (Customer)|
|#F0F4C3|Next.js UI / PWA|
|#FFE0B2|NestJS API|
|#E1BEE7|PostgreSQL & Mock Payment|

|Khách hàng (Customer)|
start
:Mở ứng dụng BrewLite;

|Next.js UI / PWA|
:Gọi API GET /products;

|NestJS API|
:Truy vấn danh sách đồ uống active;

|PostgreSQL & Mock Payment|
:SELECT * FROM "Product" WHERE isActive = true;

|Next.js UI / PWA|
if (Phản hồi API?) then ([Thành công])
  :Hiển thị lưới sản phẩm (Menu);
else ([Lỗi mạng / 500])
  :Hiển thị Error State & nút Thử lại;
  detach
endif

|Khách hàng (Customer)|
:Chọn đồ uống, chọn Size (S/M/L) và Toppings;
:Bấm "Thêm vào giỏ hàng";

|Next.js UI / PWA|
:Cập nhật giỏ hàng và tổng tiền tạm tính;

|Khách hàng (Customer)|
:Bấm nút "Thanh toán";

|Next.js UI / PWA|
if (Đã đăng nhập?) then ([Chưa đăng nhập])
  :Chuyển hướng đến màn hình Đăng nhập;
  |Khách hàng (Customer)|
  :Nhập email và mật khẩu;
  |Next.js UI / PWA|
  :POST /auth/login;
  |NestJS API|
  :Xác thực mật khẩu (bcrypt);
  :Trả về mã Bearer JWT;
  |Next.js UI / PWA|
  :Lưu JWT và quay lại trang giỏ hàng;
else ([Đã có JWT])
endif

:Gửi yêu cầu POST /orders + Bearer JWT;

|NestJS API|
:Xác thực JWT Guard & ValidationPipe DTO;
:Lấy đơn giá gốc, delta size, phụ phí topping từ DB;
:Mở Database Transaction;

|PostgreSQL & Mock Payment|
:Thực hiện UPDATE Product SET stock = stock - qty\nWHERE id = :id AND stock >= qty;

|NestJS API|
if (Số lượng tồn kho còn đủ?) then ([Không đủ tồn kho])
  |PostgreSQL & Mock Payment|
  :ROLLBACK Transaction;
  |NestJS API|
  :Trả về HTTP 409 OUT_OF_STOCK;
  |Next.js UI / PWA|
  :Hiển thị thông báo hết hàng;\nBảo lưu giỏ hàng cho khách;
  detach
else ([Đủ tồn kho])
  |PostgreSQL & Mock Payment|
  :INSERT Order (PENDING) & OrderItems;\nCOMMIT Transaction;
  |NestJS API|
  :Trả về HTTP 201 Created (orderId, total, PENDING);
endif

|Next.js UI / PWA|
:Hiển thị phương thức thanh toán (Ví / Thẻ);

|Khách hàng (Customer)|
:Chọn Ví điện tử hoặc Thẻ ngân hàng;
:Bấm "Xác nhận trả";

|Next.js UI / PWA|
:Sinh mã UUID Idempotency-Key mới;\nGửi POST /payments + Idempotency-Key;

|NestJS API|
:Kiểm tra Idempotency-Key trong CSDL;
if (Khóa đã tồn tại?) then ([Đã tồn tại cùng Payload])
  :Trả về kết quả giao dịch đã lưu trước đó;
  |Next.js UI / PWA|
  :Hiển thị kết quả idempotent;
  detach
else ([Khóa mới])
  :Lưu Payment (PROCESSING) + payloadHash;
  :Gọi Mock Payment Service (ngoài DB Transaction);
  |PostgreSQL & Mock Payment|
  :Mô phỏng xử lý thanh toán (Ví/Thẻ);
  if (Kết quả thanh toán?) then ([SUCCESS])
    |NestJS API|
    :Mở Transaction ngắn:\n- Cập nhật Payment SUCCEEDED\n- Cập nhật Order PAID\n- Ghi LoyaltyTransaction (unique orderId);
    |PostgreSQL & Mock Payment|
    :COMMIT Transaction;
    |NestJS API|
    :Trả về HTTP 200 OK (PAID, mã đơn);
    |Next.js UI / PWA|
    :Xóa giỏ hàng;\nHiển thị màn hình Xác nhận (Order ID, PAID);
    |Khách hàng (Customer)|
    :Nhận đồ uống tại quầy;
    stop
  else ([FAILURE])
    |NestJS API|
    :Mở Transaction ngắn:\n- Cập nhật Payment FAILED\n- Cập nhật Order PAYMENT_FAILED\n- Hoàn trả lại tồn kho đã giữ;
    |PostgreSQL & Mock Payment|
    :COMMIT Transaction;
    |NestJS API|
    :Trả về lỗi thanh toán thất bại;
    |Next.js UI / PWA|
    :Bảo lưu giỏ hàng;\nHiển thị thông báo lỗi & cho phép thử lại;
    stop
  endif
endif
@enduml
