@startuml usecase-overview
title Sơ đồ Use-Case Tổng quát Hệ thống BrewLite (System Use Cases)

left to right direction
skinparam packageStyle rectangle

actor "Khách hàng\n(Customer - Primary)" as Customer
actor "Nhân viên quầy\n(Barista - Secondary)" as Staff
actor "Cổng thanh toán\n(Mock Payment Gateway)" as PaymentGateway

rectangle "Hệ thống BrewLite (MVP Scope)" {
  usecase "UC-01: Xem thực đơn (Menu)" as UC1
  usecase "UC-02: Xem chi tiết & tùy chọn món" as UC2
  usecase "UC-03: Quản lý giỏ hàng (Cart)" as UC3
  usecase "UC-04: Đăng ký / Đăng nhập tài khoản" as UC4
  usecase "UC-05: Đặt và thanh toán đơn hàng" as UC5
  usecase "UC-06: Xác nhận & xem lịch sử đơn" as UC6
  usecase "UC-07: Theo dõi trạng thái đơn hàng" as UC7
  usecase "UC-08: Chuyển trạng thái đơn (Phân quyền)" as UC8
  usecase "UC-09: Khuyến mãi & tích điểm thưởng" as UC9
}

Customer --> UC1
Customer --> UC2
Customer --> UC3
Customer --> UC4
Customer --> UC5
Customer --> UC6
Customer --> UC7

Staff --> UC8

UC5 ..> UC4 : <<include>>\n(nếu chưa đăng nhập)
UC5 ..> UC9 : <<extend>>\n(khi có mã hoặc tích điểm)
UC6 ..> UC5 : <<precedes>>

UC5 --> PaymentGateway : Nhận kết quả mô phỏng (SUCCESS/FAILURE)
@enduml
